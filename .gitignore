# 数据与归档目录：本地留存，不入库
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# 原始归档（政策原文快照，体积大）
data/raw/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# 客户资料：绝不入库（即使误放也不能被提交）
clients/
客户资料/
*.xlsx
*.xls
!templates/*.xlsx

# 日志
logs/
*.log

# 编辑器
.vscode/
.idea/
*.swp

# Agent 会话记录：里面是完整对话与推理过程，公开仓库绝不能带
.reasonix/

# 测试与构建缓存
.pytest_cache/
src/*.egg-info/

# 工具二进制：体积大，各人按 docs 自行下载
tools/*.exe
tools/*.msi

# 内部交接文档：含真实公网地址、账号名等运行现场信息，公开仓库绝不能带。
# ⚠ 新写这类文档时，记得往这里加一行 —— 漏一个就等于把运行现场公开了。
docs/交接状态.md
docs/重启后恢复.md
docs/对外部署.md

# 对外暴露的脚本：里面写着本机的代理端口、隧道用法与外网地址。
# ⚠ tools/start_public.py 当初**漏了这条规则**，于是被跟踪进 2 个提交，
# 最后只能用 git filter-repo 从历史里抹掉。加规则时要把"同类的下一个脚本"
# 一起想到，别只加当前这一个文件名。
tools/start_public.py
tools/start_funnel.py
